# Test for an interactive shell
if [[ $- != *i* ]]; then
  # Shell is non-interactive.  Be done now!
  return
fi

# User specific aliases and functions
if [ -f ~/.bash_aliases ]; then
  . "$HOME/.bash_aliases"
fi

# bash history options
HISTSIZE=100000
HISTCONTROL=ignorespace:ignoredups:erasedups

alias vi="nvim"
alias vim="nvim"
export VISUAL=/usr/bin/nvim
export EDITOR=/usr/bin/nvim
export REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# options related to kubectl
kubectl_alias=k
alias ${kubectl_alias}=kubectl
complete -o default -F __start_kubectl ${kubectl_alias}

# Enable Coder's native Bash completion when Coder is installed.
if command -v coder >/dev/null 2>&1; then
  if coder_completion="$(coder completion --shell bash --print 2>/dev/null)"; then
    eval "$coder_completion"
  fi
  unset coder_completion
fi

# Configure AI API keys and other local secrets outside chezmoi source.
if [ -f "$HOME/.config/shell/secrets.local" ]; then
  . "$HOME/.config/shell/secrets.local"
fi

if [ -n "${AI_CLI_OTEL_INGEST_TOKEN:-}" ]; then
  export CLAUDE_CODE_ENABLE_TELEMETRY=1
  export OTEL_METRICS_EXPORTER=otlp
  export OTEL_LOGS_EXPORTER=otlp
  export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
  export OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.apps.k8s.infrastructure.lab.example.com
  export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer ${AI_CLI_OTEL_INGEST_TOKEN}"
  export OTEL_RESOURCE_ATTRIBUTES="service.name=claude-code,deployment.environment=lab,user.name=${USER}"
fi

# Add user bin to PATH
export PATH=~/.local/bin:$PATH

# Add Rust cargo binaries to PATH
export PATH=~/.cargo/bin:$PATH

# Add user npm binaries to PATH
export PATH=~/.npm-global/bin:$PATH

# Add opencode binaries to PATH (if installed)
if [ -d "$HOME/.opencode/bin" ]; then
  export PATH="$HOME/.opencode/bin:$PATH"
fi

# This enables worktrunk shell integration (https://github.com/max-sixty/worktrunk).
if command -v wt >/dev/null 2>&1; then
  eval "$(command wt config shell init bash)"
fi

# Enable zoxide directory jumping when zoxide is installed.
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi
