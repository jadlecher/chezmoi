personality = "pragmatic"
model = "gpt-5.3-codex"
model_reasoning_effort = "medium"
plan_mode_reasoning_effort = "high"

{{- $path := joinPath .chezmoi.homeDir ".codex/config.toml" -}}
{{- if stat $path }}
{{- $projects := output "awk" "{ if(index($0,\"[projects.\")==1) cap=1; if(cap && substr($0,1,1)==\"[\" && index($0,\"[projects.\")!=1) cap=0; if(cap) print }" $path -}}
{{- if ne (trim $projects) "" }}
{{ $projects }}

{{- end }}
{{- end }}
[features]
use_linux_sandbox_bwrap = true
multi_agent = true

[tui]
notifications = ["approval-requested"]
notifications_min_timeout_ms = 0
theme = "catppuccin-latte"

[notice]
hide_rate_limit_model_nudge = true

{{- if stat $path }}
{{- $migrations := output "awk" "{ if(index($0,\"[notice.model_migrations]\")==1) cap=1; if(cap && substr($0,1,1)==\"[\" && index($0,\"[notice.model_migrations]\")!=1) cap=0; if(cap) print }" $path -}}
{{- if ne (trim $migrations) "" }}
{{ $migrations }}
{{- end }}
{{- end }}
