{{- $path := joinPath .chezmoi.homeDir ".codex/config.toml" -}}
{{- $secretsPath := joinPath .chezmoi.homeDir ".config/shell/secrets.local" -}}
{{- $otelDomain := "" -}}
{{- if stat $secretsPath -}}
{{- $otelDomain = trimAll "\"'" (trim (output "awk" "/^[[:space:]]*(export[[:space:]]+)?OTEL_DOMAIN[[:space:]]*=/ { sub(/^[[:space:]]*(export[[:space:]]+)?OTEL_DOMAIN[[:space:]]*=[[:space:]]*/, \"\", $0); print; exit }" $secretsPath)) -}}
{{- end }}
{{- $model := "" -}}
{{- $modelReasoningEffort := "" -}}
{{- $planModeReasoningEffort := "" -}}
{{- $projects := "" -}}
{{- $tuiNux := "" -}}
{{- $migrations := "" -}}
{{- $wanderlog := "" -}}
{{- $hooksState := "" -}}
{{- if stat $path }}
{{- $model = output "awk" "BEGIN { section = 0 } /^\\[/ { section = 1 } section == 0 && /^[[:space:]]*model[[:space:]]*=/ { print; exit }" $path -}}
{{- $modelReasoningEffort = output "awk" "BEGIN { section = 0 } /^\\[/ { section = 1 } section == 0 && /^[[:space:]]*model_reasoning_effort[[:space:]]*=/ { print; exit }" $path -}}
{{- $planModeReasoningEffort = output "awk" "BEGIN { section = 0 } /^\\[/ { section = 1 } section == 0 && /^[[:space:]]*plan_mode_reasoning_effort[[:space:]]*=/ { print; exit }" $path -}}
{{- $projects = output "awk" "{ if(index($0,\"[projects.\")==1) cap=1; if(cap && substr($0,1,1)==\"[\" && index($0,\"[projects.\")!=1) cap=0; if(cap) print }" $path -}}
{{- $tuiNux = output "awk" "{ if(index($0,\"[tui.model_availability_nux]\")==1) cap=1; if(cap && substr($0,1,1)==\"[\" && index($0,\"[tui.model_availability_nux]\")!=1) cap=0; if(cap) print }" $path -}}
{{- $migrations = output "awk" "{ if(index($0,\"[notice.model_migrations]\")==1) cap=1; if(cap && substr($0,1,1)==\"[\" && index($0,\"[notice.model_migrations]\")!=1) cap=0; if(cap) print }" $path -}}
{{- $wanderlog = output "awk" "{ if(index($0,\"[mcp_servers.wanderlog\")==1) cap=1; if(cap && substr($0,1,1)==\"[\" && index($0,\"[mcp_servers.wanderlog\")!=1) cap=0; if(cap) print }" $path -}}
{{- $hooksState = output "awk" "{ if(index($0,\"[hooks.state]\")==1) cap=1; if(cap) print }" $path -}}
{{- end }}
personality = "pragmatic"
{{- if ne (trim $model) "" }}
{{ trim $model }}
{{- else }}
model = "gpt-5.6-terra"
{{- end }}
{{- if ne (trim $modelReasoningEffort) "" }}
{{ trim $modelReasoningEffort }}
{{- else }}
model_reasoning_effort = "medium"
{{- end }}
{{- if ne (trim $planModeReasoningEffort) "" }}
{{ trim $planModeReasoningEffort }}
{{- else }}
plan_mode_reasoning_effort = "high"
{{- end }}
approvals_reviewer = "auto_review"

{{- if ne (trim $projects) "" }}
{{ trim $projects }}
{{- end }}
[features]
use_linux_sandbox_bwrap = true
multi_agent = true
hooks = true

[tui]
notifications = ["approval-requested"]
notifications_min_timeout_ms = 0
theme = "catppuccin-latte"
status_line = ["model-with-reasoning", "current-dir", "context-usage", "five-hour-limit", "weekly-limit"]

{{- if ne (trim $tuiNux) "" }}
{{ trim $tuiNux }}
{{- end }}
[notice]
hide_rate_limit_model_nudge = true

{{- if ne (trim $migrations) "" }}
{{ trim $migrations }}
{{- end }}
{{- if ne $otelDomain "" }}
[otel]
environment = "lab"
log_user_prompt = false

[otel.exporter]
otlp-http = { endpoint = "https://otel.apps.k8s.infrastructure.lab.{{ $otelDomain }}/v1/logs", protocol = "binary" }
{{- end }}

[marketplaces.personal-codex-hooks]
source_type = "local"
source = "{{ joinPath .chezmoi.homeDir ".codex/rate-limit-marketplace" }}"

[plugins."codex-rate-limit-exporter@personal-codex-hooks"]
enabled = true

[mcp_servers.chrome-devtools]
command = "npx"
args = ["-y", "chrome-devtools-mcp@latest", "--browser-url=http://127.0.0.1:9222", "--no-usage-statistics"]

[mcp_servers.chrome-devtools.tools.new_page]
approval_mode = "approve"

[mcp_servers.chrome-devtools.tools.take_snapshot]
approval_mode = "approve"

[mcp_servers.chrome-devtools.tools.get_network_request]
approval_mode = "approve"

[mcp_servers.chrome-devtools.tools.click]
approval_mode = "approve"

[mcp_servers.chrome-devtools.tools.navigate_page]
approval_mode = "approve"

[mcp_servers.chrome-devtools.tools.evaluate_script]
approval_mode = "approve"

[mcp_servers.chrome-devtools.tools.handle_dialog]
approval_mode = "approve"

{{- if ne (trim $wanderlog) "" }}

{{ trim $wanderlog }}
{{- end }}

{{- if ne (trim $hooksState) "" }}

{{ trim $hooksState }}
{{- end }}
