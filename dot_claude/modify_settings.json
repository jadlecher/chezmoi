{{- /* chezmoi:modify-template */ -}}
{{- $current := dict -}}
{{- if ne (trim .chezmoi.stdin) "" -}}
{{- $current = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $secretsPath := joinPath .chezmoi.homeDir ".config/shell/secrets.local" -}}
{{- $otelDomain := "" -}}
{{- if stat $secretsPath -}}
{{- $otelDomain = trimAll "\"'" (trim (output "awk" "/^[[:space:]]*(export[[:space:]]+)?OTEL_DOMAIN[[:space:]]*=/ { sub(/^[[:space:]]*(export[[:space:]]+)?OTEL_DOMAIN[[:space:]]*=[[:space:]]*/, \"\", $0); print; exit }" $secretsPath)) -}}
{{- end -}}
{{- $otelEndpoint := "" -}}
{{- if ne $otelDomain "" -}}
{{- $otelEndpoint = printf "https://otel.apps.k8s.infrastructure.lab.%s" $otelDomain -}}
{{- end -}}
{{- $managed := `
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "OTEL_EXPORTER_OTLP_ENDPOINT": OTEL_ENDPOINT_PLACEHOLDER
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'notify-send -u critical \"Claude: Permission Required\" \"Claude is waiting for your permission response.\" >/dev/null 2>&1 || printf \"\\\\a\"'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 /home/james/.claude/rate-limit-exporter.py"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "showClearContextOnPlanAccept": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "tui": "fullscreen",
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "autoMemoryEnabled": false
}
` | replace "OTEL_ENDPOINT_PLACEHOLDER" (toJson $otelEndpoint) | fromJson -}}
{{- $target := deepCopy $current -}}
{{- $target = mergeOverwrite $target $managed -}}
{{- if deepEqual $current $target -}}
{{ .chezmoi.stdin -}}
{{- else -}}
{{ printf "%s\n" ($target | toPrettyJson) -}}
{{- end -}}
