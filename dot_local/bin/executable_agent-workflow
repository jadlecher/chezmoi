#!/usr/bin/env bash
set -euo pipefail

LOCAL_DEV_BIN="/home/james/src/utils/agent-workflow/bin/agent-workflow"
RELEASE_BIN="${HOME}/.local/share/agent-workflow/bin/agent-workflow"

if [[ -x "${LOCAL_DEV_BIN}" ]]; then
  exec "${LOCAL_DEV_BIN}" "$@"
fi

if [[ -x "${RELEASE_BIN}" ]]; then
  exec "${RELEASE_BIN}" "$@"
fi

cat >&2 <<'EOF'
agent-workflow binary not found.
Checked:
  - /home/james/src/utils/agent-workflow/bin/agent-workflow (local development override)
  - ~/.local/share/agent-workflow/bin/agent-workflow (installed release)
EOF
exit 1
