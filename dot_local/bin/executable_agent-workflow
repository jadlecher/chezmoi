#!/usr/bin/env python3

from __future__ import annotations

import argparse
import curses
import datetime as dt
import json
import os
import pathlib
import shlex
import shutil
import sqlite3
import subprocess
import sys
import textwrap
import time
from dataclasses import dataclass
from typing import Any


STATE_HOME = pathlib.Path(os.environ.get("XDG_STATE_HOME", str(pathlib.Path.home() / ".local/state"))).expanduser()
STATE_DIR = STATE_HOME / "agent-workflow"
NVIM_STATE_DIR = STATE_DIR / "nvim"
SCAN_CACHE_PATH = STATE_DIR / "current-scan.json"
KITTY_SOCKET = os.environ.get("KITTY_LISTEN_ON", "unix:/tmp/kitty")
REFRESH_SECONDS = 2
STALE_SECONDS = 15 * 60
RUNNING_SECONDS = 90
LOOKBACK_SECONDS = 7 * 24 * 60 * 60
MAX_CLAUDE_TAIL_LINES = 160
MAX_CODEX_LOGS = 30
MAX_OPENCODE_PARTS = 48
STATE_PRIORITY = {
    "needs_permission": 0,
    "needs_input": 1,
    "ready_for_orders": 2,
    "running": 3,
    "interrupted": 4,
    "error": 5,
    "stale": 6,
}
STATE_LABELS = {
    "needs_permission": "perm",
    "needs_input": "input",
    "ready_for_orders": "ready",
    "running": "run",
    "interrupted": "stop",
    "error": "err",
    "stale": "stale",
}
TOOL_ORDER = {"codex": 0, "claude": 1, "opencode": 2}


@dataclass
class SessionRecord:
    session_key: str
    tool: str
    tool_session_id: str
    cwd: str
    worktree_root: str
    branch: str
    title: str
    state: str
    state_reason: str
    last_activity_at: str
    attention_score: int
    needs_action: bool
    kitty_target: dict[str, Any] | None
    nvim_target: dict[str, Any] | None

    def to_dict(self) -> dict[str, Any]:
        return {
            "session_key": self.session_key,
            "tool": self.tool,
            "tool_session_id": self.tool_session_id,
            "cwd": self.cwd,
            "worktree_root": self.worktree_root,
            "branch": self.branch,
            "title": self.title,
            "state": self.state,
            "state_reason": self.state_reason,
            "last_activity_at": self.last_activity_at,
            "attention_score": self.attention_score,
            "needs_action": self.needs_action,
            "kitty_target": self.kitty_target,
            "nvim_target": self.nvim_target,
        }


def ensure_state_dirs() -> None:
    NVIM_STATE_DIR.mkdir(parents=True, exist_ok=True)


def now_utc() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc)


def epoch_to_iso(value: float | int | None, *, milliseconds: bool = False) -> str:
    if value is None:
        return ""
    try:
        ts = float(value)
    except (TypeError, ValueError):
        return ""
    if milliseconds:
        ts /= 1000.0
    return dt.datetime.fromtimestamp(ts, tz=dt.timezone.utc).isoformat()


def iso_to_datetime(value: str | None) -> dt.datetime | None:
    if not value:
        return None
    try:
        return dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def normalize_path(path: str | None) -> str:
    if not path:
        return ""
    try:
        return str(pathlib.Path(path).expanduser().resolve(strict=False))
    except OSError:
        return str(pathlib.Path(path).expanduser())


def run_command(args: list[str], *, timeout: float = 2.0) -> str:
    try:
        completed = subprocess.run(
            args,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if completed.returncode != 0:
        return ""
    return completed.stdout.strip()


def git_root(path: str) -> str:
    output = run_command(["git", "-C", path, "rev-parse", "--show-toplevel"])
    return normalize_path(output) if output else normalize_path(path)


def git_branch(path: str) -> str:
    output = run_command(["git", "-C", path, "rev-parse", "--abbrev-ref", "HEAD"])
    if not output or output == "HEAD":
        return ""
    return output


def shell_join(parts: list[str]) -> str:
    return " ".join(shlex.quote(part) for part in parts)


def trim_title(title: str, width: int = 64) -> str:
    single = " ".join((title or "").split())
    if len(single) <= width:
        return single
    return single[: width - 1] + "..."


def age_text(iso_value: str) -> str:
    stamp = iso_to_datetime(iso_value)
    if not stamp:
        return "?"
    delta = int((now_utc() - stamp).total_seconds())
    if delta < 60:
        return f"{delta}s"
    if delta < 3600:
        return f"{delta // 60}m"
    if delta < 86400:
        return f"{delta // 3600}h"
    return f"{delta // 86400}d"


def score_state(state: str) -> tuple[int, int]:
    attention = {
        "needs_permission": 100,
        "needs_input": 90,
        "ready_for_orders": 70,
        "running": 40,
        "interrupted": 60,
        "error": 80,
        "stale": 10,
    }.get(state, 0)
    return attention, int(state in {"needs_permission", "needs_input"})


def session_age_seconds(iso_value: str) -> int | None:
    stamp = iso_to_datetime(iso_value)
    if not stamp:
        return None
    return int((now_utc() - stamp).total_seconds())


def sort_sessions(sessions: list[SessionRecord]) -> list[SessionRecord]:
    def key(record: SessionRecord) -> tuple[int, int, int, int, str]:
        last_dt = iso_to_datetime(record.last_activity_at) or dt.datetime.fromtimestamp(0, tz=dt.timezone.utc)
        return (
            STATE_PRIORITY.get(record.state, 99),
            -record.attention_score,
            -int(last_dt.timestamp()),
            TOOL_ORDER.get(record.tool, 99),
            record.session_key,
        )

    return sorted(sessions, key=key)


def load_json(path: pathlib.Path) -> Any:
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None


def read_jsonl_tail(path: pathlib.Path, limit: int) -> list[dict[str, Any]]:
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return []
    records: list[dict[str, Any]] = []
    for line in lines[-limit:]:
        try:
            value = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(value, dict):
            records.append(value)
    return records


def flatten_text_content(content: Any) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts: list[str] = []
        for item in content:
            if not isinstance(item, dict):
                continue
            item_type = item.get("type")
            if item_type in {"text", "thinking", "reasoning"} and isinstance(item.get("text") or item.get("thinking"), str):
                parts.append(item.get("text") or item.get("thinking") or "")
        return "\n".join(parts).strip()
    return ""


def looks_like_question(text: str) -> bool:
    sample = text.strip().lower()
    if not sample:
        return False
    if "?" in sample:
        return True
    for phrase in (
        "need your input",
        "which option",
        "how should",
        "do you want",
        "pick one",
        "choose one",
    ):
        if phrase in sample:
            return True
    return False


def detect_tool_name(text: str) -> str:
    lowered = text.lower()
    if "codex" in lowered:
        return "codex"
    if "claude" in lowered:
        return "claude"
    if "opencode" in lowered:
        return "opencode"
    return ""


def load_nvim_registry() -> list[dict[str, Any]]:
    records: list[dict[str, Any]] = []
    for path in sorted(NVIM_STATE_DIR.glob("*.json")):
        data = load_json(path)
        if not isinstance(data, dict):
            continue
        updated_at = data.get("updated_at")
        stamp = iso_to_datetime(updated_at if isinstance(updated_at, str) else "")
        if stamp and (now_utc() - stamp).total_seconds() > STALE_SECONDS:
            continue
        data["_path"] = str(path)
        records.append(data)
    return records


def nvim_match_score(session_path: str, record: dict[str, Any]) -> tuple[int, int]:
    cwd = normalize_path(record.get("cwd"))
    if not cwd:
        return (99, 0)
    if cwd == session_path:
        return (0, len(cwd))
    if session_path.startswith(cwd + os.sep) or cwd.startswith(session_path + os.sep):
        return (1, min(len(cwd), len(session_path)))
    return (99, 0)


def select_nvim_target(session: dict[str, Any], records: list[dict[str, Any]]) -> dict[str, Any] | None:
    session_path = normalize_path(session.get("cwd"))
    tool = session.get("tool")
    matches = []
    for record in records:
        score = nvim_match_score(session_path, record)
        if score[0] >= 99:
            continue
        record_tool = record.get("tool") or detect_tool_name(record.get("display_name", ""))
        bonus = 0 if tool and record_tool == tool else 1
        updated_at = iso_to_datetime(record.get("updated_at")) or dt.datetime.fromtimestamp(0, tz=dt.timezone.utc)
        matches.append((score[0], bonus, -int(updated_at.timestamp()), -score[1], record))
    if not matches:
        return None
    return matches[0][-1]


def kitty_window_cwd(window: dict[str, Any]) -> str:
    for key in ("cwd", "current_cwd"):
        value = window.get(key)
        if isinstance(value, str) and value:
            return normalize_path(value)
    for proc in window.get("foreground_processes", []) or []:
        if isinstance(proc, dict):
            value = proc.get("cwd")
            if isinstance(value, str) and value:
                return normalize_path(value)
    return ""


def load_kitty_targets() -> list[dict[str, Any]]:
    kitten = shutil.which("kitten")
    if not kitten:
        return []
    output = run_command([kitten, "@", "--to", KITTY_SOCKET, "ls"], timeout=1.0)
    if not output:
        return []
    try:
        data = json.loads(output)
    except json.JSONDecodeError:
        return []
    targets: list[dict[str, Any]] = []
    if not isinstance(data, list):
        return targets
    for os_window in data:
        if not isinstance(os_window, dict):
            continue
        os_window_id = os_window.get("id")
        for tab in os_window.get("tabs", []) or []:
            if not isinstance(tab, dict):
                continue
            tab_id = tab.get("id")
            for window in tab.get("windows", []) or []:
                if not isinstance(window, dict):
                    continue
                cwd = kitty_window_cwd(window)
                if not cwd:
                    continue
                targets.append(
                    {
                        "socket": KITTY_SOCKET,
                        "os_window_id": os_window_id,
                        "tab_id": tab_id,
                        "window_id": window.get("id"),
                        "title": window.get("title") or tab.get("title") or "",
                        "cwd": cwd,
                    }
                )
    return targets


def select_kitty_target(session: dict[str, Any], targets: list[dict[str, Any]]) -> dict[str, Any] | None:
    session_path = normalize_path(session.get("cwd"))
    matches = []
    for target in targets:
        cwd = normalize_path(target.get("cwd"))
        if not cwd:
            continue
        if cwd == session_path:
            matches.append((0, -len(cwd), target))
        elif session_path.startswith(cwd + os.sep) or cwd.startswith(session_path + os.sep):
            matches.append((1, -min(len(cwd), len(session_path)), target))
    if not matches:
        return None
    matches.sort(key=lambda item: (item[0], item[1]))
    return matches[0][2]


class CodexCollector:
    def __init__(self) -> None:
        self.state_db = pathlib.Path.home() / ".codex/state_5.sqlite"
        self.logs_db = pathlib.Path.home() / ".codex/logs_1.sqlite"

    def available(self) -> bool:
        return self.state_db.exists()

    def collect(self) -> list[dict[str, Any]]:
        if not self.available():
            return []
        conn = sqlite3.connect(str(self.state_db))
        conn.row_factory = sqlite3.Row
        sessions = [
            dict(row)
            for row in conn.execute(
                """
                select
                    id,
                    cwd,
                    title,
                    updated_at,
                    git_branch,
                    agent_role,
                    agent_nickname,
                    archived
                from threads
                where archived = 0
                order by updated_at desc
                """
            ).fetchall()
        ]
        logs_by_thread = self._load_state_logs(conn)
        conn.close()
        feedback_by_thread = self._load_feedback_logs()
        records: list[dict[str, Any]] = []
        for session in sessions:
            records.append(self._normalize_session(session, logs_by_thread.get(session["id"], []), feedback_by_thread.get(session["id"], [])))
        return records

    def _load_state_logs(self, conn: sqlite3.Connection) -> dict[str, list[dict[str, Any]]]:
        rows = conn.execute(
            """
            select thread_id, ts, level, target, message
            from logs
            where thread_id is not null
            order by ts desc, ts_nanos desc, id desc
            limit 5000
            """
        ).fetchall()
        grouped: dict[str, list[dict[str, Any]]] = {}
        for row in rows:
            thread_id = row["thread_id"]
            grouped.setdefault(thread_id, [])
            if len(grouped[thread_id]) >= MAX_CODEX_LOGS:
                continue
            grouped[thread_id].append(dict(row))
        return grouped

    def _load_feedback_logs(self) -> dict[str, list[dict[str, Any]]]:
        if not self.logs_db.exists():
            return {}
        conn = sqlite3.connect(str(self.logs_db))
        conn.row_factory = sqlite3.Row
        rows = conn.execute(
            """
            select thread_id, ts, level, target, feedback_log_body
            from logs
            where thread_id is not null
            order by ts desc, id desc
            limit 4000
            """
        ).fetchall()
        conn.close()
        grouped: dict[str, list[dict[str, Any]]] = {}
        for row in rows:
            thread_id = row["thread_id"]
            grouped.setdefault(thread_id, [])
            if len(grouped[thread_id]) >= MAX_CODEX_LOGS:
                continue
            grouped[thread_id].append(dict(row))
        return grouped

    def _normalize_session(self, session: dict[str, Any], logs: list[dict[str, Any]], feedback_logs: list[dict[str, Any]]) -> dict[str, Any]:
        title = session.get("title") or ""
        branch = session.get("git_branch") or git_branch(session.get("cwd") or "")
        last_activity_at = epoch_to_iso(session.get("updated_at"))
        state, reason = self._classify(logs, feedback_logs, last_activity_at)
        return {
            "tool": "codex",
            "tool_session_id": session["id"],
            "cwd": normalize_path(session.get("cwd")),
            "worktree_root": git_root(session.get("cwd") or ""),
            "branch": branch,
            "title": trim_title(title),
            "state": state,
            "state_reason": reason,
            "last_activity_at": last_activity_at,
        }

    def _classify(
        self,
        logs: list[dict[str, Any]],
        feedback_logs: list[dict[str, Any]],
        last_activity_at: str,
    ) -> tuple[str, str]:
        combined = []
        for row in logs:
            combined.append((row.get("ts") or 0, row.get("message") or "", row.get("level") or "INFO"))
        for row in feedback_logs:
            combined.append((row.get("ts") or 0, row.get("feedback_log_body") or "", row.get("level") or "INFO"))
        combined.sort(key=lambda item: item[0], reverse=True)
        latest = combined[0] if combined else None
        latest_text = latest[1] if latest else ""
        lowered = latest_text.lower()
        age_seconds = session_age_seconds(last_activity_at) or 10**9

        latest_request = None
        latest_permission = None
        latest_user_dispatch = None
        for ts, text, _ in combined:
            if latest_request is None and "ToolCall: request_user_input" in text:
                latest_request = ts
            if latest_permission is None and '"sandbox_permissions":"require_escalated"' in text:
                latest_permission = ts
            if latest_user_dispatch is None and 'codex.op="user_input"' in text:
                latest_user_dispatch = ts

        if latest_request and (not latest_user_dispatch or latest_request >= latest_user_dispatch):
            if latest and latest[0] == latest_request:
                return "needs_input", "waiting for explicit user input"
        if latest_permission and (not latest_user_dispatch or latest_permission >= latest_user_dispatch):
            if latest and latest[0] == latest_permission:
                return "needs_permission", "awaiting sandbox approval"

        if latest and latest[2].upper() == "ERROR":
            return "error", trim_title(latest_text, 48) or "recent error in Codex logs"
        if "function call output is missing" in lowered:
            return "error", "tool call output missing"
        if "interrupt" in lowered and "toolcall" not in lowered:
            return "interrupted", trim_title(latest_text, 48) or "session interrupted"
        if "ToolCall: wait" in latest_text:
            return "running", "waiting on spawned agent work"
        if latest_text:
            if age_seconds <= RUNNING_SECONDS:
                return "running", "recent Codex activity"
            return "ready_for_orders", "last turn appears complete"
        if age_seconds > STALE_SECONDS:
            return "stale", "no recent Codex logs"
        return "ready_for_orders", "metadata present without recent logs"


class ClaudeCollector:
    def __init__(self) -> None:
        self.projects_dir = pathlib.Path.home() / ".claude/projects"

    def available(self) -> bool:
        return self.projects_dir.exists()

    def collect(self) -> list[dict[str, Any]]:
        if not self.available():
            return []
        sessions: list[dict[str, Any]] = []
        seen: set[str] = set()
        for index_path in sorted(self.projects_dir.glob("*/sessions-index.json")):
            data = load_json(index_path)
            if not isinstance(data, dict):
                continue
            for entry in data.get("entries", []) or []:
                if not isinstance(entry, dict):
                    continue
                session_id = entry.get("sessionId")
                if not session_id or session_id in seen:
                    continue
                seen.add(session_id)
                sessions.append(self._normalize_entry(entry))
        if not sessions:
            for path in sorted(self.projects_dir.glob("*/*.jsonl")):
                session_id = path.stem
                if session_id in seen:
                    continue
                seen.add(session_id)
                sessions.append(self._normalize_entry({"sessionId": session_id, "fullPath": str(path)}))
        return sessions

    def _normalize_entry(self, entry: dict[str, Any]) -> dict[str, Any]:
        path = pathlib.Path(entry.get("fullPath") or "")
        tail = read_jsonl_tail(path, MAX_CLAUDE_TAIL_LINES)
        cwd = normalize_path(entry.get("projectPath") or self._cwd_from_tail(tail))
        branch = entry.get("gitBranch") or git_branch(cwd)
        title = entry.get("summary") or entry.get("firstPrompt") or self._title_from_tail(tail)
        last_activity_at = entry.get("modified") or self._timestamp_from_tail(tail)
        state, reason = self._classify(tail, last_activity_at)
        return {
            "tool": "claude",
            "tool_session_id": entry.get("sessionId") or path.stem,
            "cwd": cwd,
            "worktree_root": git_root(cwd),
            "branch": branch,
            "title": trim_title(title),
            "state": state,
            "state_reason": reason,
            "last_activity_at": last_activity_at or epoch_to_iso(path.stat().st_mtime) if path.exists() else "",
        }

    def _cwd_from_tail(self, tail: list[dict[str, Any]]) -> str:
        for row in reversed(tail):
            cwd = row.get("cwd")
            if isinstance(cwd, str) and cwd:
                return cwd
        return ""

    def _title_from_tail(self, tail: list[dict[str, Any]]) -> str:
        for row in tail:
            if row.get("type") == "user":
                message = row.get("message")
                if isinstance(message, dict):
                    content = flatten_text_content(message.get("content") or message.get("text") or "")
                    if content:
                        return content
        return ""

    def _timestamp_from_tail(self, tail: list[dict[str, Any]]) -> str:
        for row in reversed(tail):
            value = row.get("timestamp")
            if isinstance(value, str) and value:
                return value
        return ""

    def _classify(self, tail: list[dict[str, Any]], last_activity_at: str) -> tuple[str, str]:
        latest = tail[-1] if tail else {}
        latest_type = latest.get("type")
        latest_message = latest.get("message") if isinstance(latest.get("message"), dict) else {}
        latest_text = flatten_text_content(latest_message.get("content") or latest_message.get("text") or "")
        age_seconds = 10**9
        stamp = iso_to_datetime(last_activity_at)
        if stamp:
            age_seconds = int((now_utc() - stamp).total_seconds())

        if latest_type == "user" and "[Request interrupted by user for tool use]" in latest_text:
            return "interrupted", "user interrupted tool execution"
        if any("permission denied" in json.dumps(item).lower() or "rejected" in json.dumps(item).lower() for item in tail[-12:]):
            return "needs_permission", "recent tool or permission rejection"
        if latest_type == "assistant" and latest_message.get("stop_reason") == "tool_use":
            return "running", "assistant is mid-turn on tool use"
        if latest_type == "progress":
            return "running", "progress event still active"
        if latest_type == "assistant":
            if looks_like_question(latest_text):
                return "needs_input", "assistant ended with a question"
            stop_reason = latest_message.get("stop_reason")
            if stop_reason in {"end_turn", "stop_sequence"}:
                if age_seconds > STALE_SECONDS:
                    return "stale", "finished Claude turn is now stale"
                return "ready_for_orders", "Claude turn completed"
        if latest_type == "user":
            if age_seconds <= RUNNING_SECONDS:
                return "running", "recent user prompt awaiting work"
            return "needs_input", "latest event is user-side input"
        if age_seconds > STALE_SECONDS:
            return "stale", "no recent Claude activity"
        return "running", "recent Claude activity without final turn marker"


class OpencodeCollector:
    def __init__(self) -> None:
        self.db_path = pathlib.Path.home() / ".local/share/opencode/opencode.db"

    def available(self) -> bool:
        return self.db_path.exists()

    def collect(self) -> list[dict[str, Any]]:
        if not self.available():
            return []
        conn = sqlite3.connect(str(self.db_path))
        conn.row_factory = sqlite3.Row
        sessions = [
            dict(row)
            for row in conn.execute(
                """
                select
                    id,
                    directory,
                    title,
                    permission,
                    time_created,
                    time_updated,
                    time_archived
                from session
                where time_archived is null
                order by time_updated desc
                """
            ).fetchall()
        ]
        parts_by_session = self._load_parts(conn)
        conn.close()
        records: list[dict[str, Any]] = []
        for session in sessions:
            records.append(self._normalize_session(session, parts_by_session.get(session["id"], [])))
        return records

    def _load_parts(self, conn: sqlite3.Connection) -> dict[str, list[dict[str, Any]]]:
        rows = conn.execute(
            """
            select session_id, time_created, time_updated, data
            from part
            order by time_updated desc
            limit 5000
            """
        ).fetchall()
        grouped: dict[str, list[dict[str, Any]]] = {}
        for row in rows:
            session_id = row["session_id"]
            grouped.setdefault(session_id, [])
            if len(grouped[session_id]) >= MAX_OPENCODE_PARTS:
                continue
            try:
                data = json.loads(row["data"])
            except json.JSONDecodeError:
                continue
            grouped[session_id].append(
                {
                    "time_created": row["time_created"],
                    "time_updated": row["time_updated"],
                    "data": data,
                }
            )
        for parts in grouped.values():
            parts.sort(key=lambda item: item["time_updated"])
        return grouped

    def _normalize_session(self, session: dict[str, Any], parts: list[dict[str, Any]]) -> dict[str, Any]:
        cwd = normalize_path(session.get("directory"))
        branch = git_branch(cwd)
        last_activity_at = epoch_to_iso(session.get("time_updated"), milliseconds=True)
        state, reason = self._classify(session, parts, last_activity_at)
        return {
            "tool": "opencode",
            "tool_session_id": session["id"],
            "cwd": cwd,
            "worktree_root": git_root(cwd),
            "branch": branch,
            "title": trim_title(session.get("title") or ""),
            "state": state,
            "state_reason": reason,
            "last_activity_at": last_activity_at,
        }

    def _classify(self, session: dict[str, Any], parts: list[dict[str, Any]], last_activity_at: str) -> tuple[str, str]:
        age_seconds = 10**9
        stamp = iso_to_datetime(last_activity_at)
        if stamp:
            age_seconds = int((now_utc() - stamp).total_seconds())
        if session.get("permission"):
            return "needs_permission", "session has pending permission state"
        if not parts:
            if age_seconds > STALE_SECONDS:
                return "stale", "no recent Opencode parts"
            return "running", "session metadata updated recently"

        latest = parts[-1]["data"]
        step_depth = 0
        latest_error = None
        latest_text = ""
        for item in parts:
            data = item["data"]
            if data.get("type") == "step-start":
                step_depth += 1
            elif data.get("type") == "step-finish":
                step_depth = max(step_depth - 1, 0)
            elif data.get("type") == "tool":
                state = data.get("state") or {}
                if state.get("status") == "error":
                    latest_error = data
            elif data.get("type") == "text":
                latest_text = data.get("text") or latest_text

        if latest_error:
            return "error", f"tool {latest_error.get('tool') or 'call'} returned error"
        if step_depth > 0:
            return "running", "active Opencode step in progress"
        if latest.get("type") == "text" and looks_like_question(latest.get("text") or ""):
            return "needs_input", "assistant text ended with a question"
        if latest.get("type") == "step-finish":
            reason = latest.get("reason")
            if reason == "stop":
                if age_seconds > STALE_SECONDS:
                    return "stale", "completed Opencode step is stale"
                return "ready_for_orders", "latest step completed"
            if reason == "tool-calls":
                return "running", "step finished for tool-call roundtrip"
        if latest.get("type") == "text" and latest_text:
            if age_seconds > STALE_SECONDS:
                return "stale", "text response is stale"
            return "ready_for_orders", "assistant response completed"
        if age_seconds > STALE_SECONDS:
            return "stale", "no recent Opencode activity"
        return "running", "recent Opencode activity"


def build_snapshot() -> dict[str, Any]:
    ensure_state_dirs()
    nvim_records = load_nvim_registry()
    kitty_targets = load_kitty_targets()
    sessions: list[SessionRecord] = []
    for collector in (CodexCollector(), ClaudeCollector(), OpencodeCollector()):
        for raw in collector.collect():
            attention_score, needs_action_int = score_state(raw["state"])
            raw["session_key"] = f'{raw["tool"]}:{raw["tool_session_id"]}'
            raw["attention_score"] = attention_score
            raw["needs_action"] = bool(needs_action_int)
            raw["kitty_target"] = select_kitty_target(raw, kitty_targets)
            raw["nvim_target"] = select_nvim_target(raw, nvim_records)
            age_seconds = session_age_seconds(raw["last_activity_at"])
            if (
                raw["state"] == "stale"
                and age_seconds is not None
                and age_seconds > LOOKBACK_SECONDS
                and not raw["kitty_target"]
                and not raw["nvim_target"]
            ):
                continue
            sessions.append(SessionRecord(**raw))
    ordered = sort_sessions(sessions)
    snapshot = {
        "generated_at": now_utc().isoformat(),
        "sessions": [record.to_dict() for record in ordered],
    }
    SCAN_CACHE_PATH.write_text(json.dumps(snapshot, indent=2, sort_keys=True) + "\n")
    return snapshot


def focus_kitty(target: dict[str, Any] | None) -> bool:
    if not target:
        return False
    kitten = shutil.which("kitten")
    if not kitten:
        return False
    socket = target.get("socket") or KITTY_SOCKET
    tab_id = target.get("tab_id")
    window_id = target.get("window_id")
    commands: list[list[str]] = []
    if tab_id:
        commands.append([kitten, "@", "--to", socket, "focus-tab", "--match", f"id:{tab_id}"])
    if window_id:
        commands.append([kitten, "@", "--to", socket, "focus-window", "--match", f"id:{window_id}"])
    ok = False
    for cmd in commands:
        try:
            result = subprocess.run(cmd, check=False, capture_output=True, text=True, timeout=1.5)
        except (OSError, subprocess.TimeoutExpired):
            return ok
        ok = ok or result.returncode == 0
    return ok


def focus_nvim(target: dict[str, Any] | None, session_key: str) -> bool:
    if not target:
        return False
    server = target.get("server")
    if not isinstance(server, str) or not server:
        return False
    bufnr = int(target.get("bufnr") or 0)
    tabnr = int(target.get("tabnr") or 0)
    nvim = shutil.which("nvim")
    if not nvim or bufnr <= 0:
        return False
    if shutil.which("nvr"):
        cmd = [
            "nvr",
            "--servername",
            server,
            "--remote-send",
            f"<Cmd>AgentWorkflowFocus {session_key}<CR>",
        ]
    else:
        cmd = [
            nvim,
            "--server",
            server,
            "--remote-send",
            f"<Cmd>lua require('utils.terminal-names').focus_buffer({tabnr}, {bufnr})<CR>",
        ]
    try:
        result = subprocess.run(cmd, check=False, capture_output=True, text=True, timeout=1.5)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0


def find_session(snapshot: dict[str, Any], session_key: str) -> dict[str, Any] | None:
    for session in snapshot.get("sessions", []):
        if session.get("session_key") == session_key:
            return session
    return None


def print_summary(snapshot: dict[str, Any]) -> None:
    sessions = snapshot.get("sessions", [])
    counts = {
        "attention": 0,
        "ready": 0,
        "running": 0,
        "stale": 0,
        "interrupted": 0,
        "error": 0,
    }
    for session in sessions:
        state = session.get("state")
        if state in {"needs_permission", "needs_input"}:
            counts["attention"] += 1
        elif state == "ready_for_orders":
            counts["ready"] += 1
        elif state == "running":
            counts["running"] += 1
        elif state == "stale":
            counts["stale"] += 1
        elif state == "interrupted":
            counts["interrupted"] += 1
        elif state == "error":
            counts["error"] += 1
    parts = [f"{key}={value}" for key, value in counts.items()]
    print(" ".join(parts))


def format_row(session: dict[str, Any], width: int) -> str:
    badge = STATE_LABELS.get(session.get("state"), session.get("state", "?")[:5])
    repo = pathlib.Path(session.get("worktree_root") or session.get("cwd") or ".").name
    branch = session.get("branch") or "-"
    title = session.get("title") or "-"
    reason = session.get("state_reason") or "-"
    age = age_text(session.get("last_activity_at") or "")
    base = f"{session.get('tool','?'):<8} [{badge:<5}] {repo:<18.18} {branch:<18.18} {age:>4} {title}"
    remaining = max(width - len(base) - 3, 8)
    return f"{base} :: {textwrap.shorten(reason, width=remaining, placeholder='...')}"


def filter_sessions(sessions: list[dict[str, Any]], query: str) -> list[dict[str, Any]]:
    query = query.strip().lower()
    if not query:
        return sessions
    filtered = []
    for session in sessions:
        haystack = " ".join(
            [
                str(session.get("tool", "")),
                str(session.get("cwd", "")),
                str(session.get("worktree_root", "")),
                str(session.get("branch", "")),
                str(session.get("title", "")),
                str(session.get("state_reason", "")),
            ]
        ).lower()
        if query in haystack:
            filtered.append(session)
    return filtered


def dashboard_sections(sessions: list[dict[str, Any]]) -> list[tuple[str, list[dict[str, Any]]]]:
    groups = {
        "Needs Attention": [],
        "Ready": [],
        "Running": [],
        "Interrupted/Errored": [],
        "Stale": [],
    }
    for session in sessions:
        state = session.get("state")
        if state in {"needs_permission", "needs_input"}:
            groups["Needs Attention"].append(session)
        elif state == "ready_for_orders":
            groups["Ready"].append(session)
        elif state == "running":
            groups["Running"].append(session)
        elif state in {"interrupted", "error"}:
            groups["Interrupted/Errored"].append(session)
        else:
            groups["Stale"].append(session)
    return [(name, rows) for name, rows in groups.items()]


def run_dashboard() -> int:
    def main(stdscr: Any) -> int:
        curses.curs_set(0)
        stdscr.nodelay(True)
        selected_index = 0
        query = ""
        snapshot = build_snapshot()
        last_refresh = time.monotonic()

        while True:
            if time.monotonic() - last_refresh >= REFRESH_SECONDS:
                snapshot = build_snapshot()
                last_refresh = time.monotonic()

            sessions = filter_sessions(snapshot.get("sessions", []), query)
            sessions = sort_sessions([SessionRecord(**session) for session in sessions])
            session_dicts = [session.to_dict() for session in sessions]
            if selected_index >= len(session_dicts):
                selected_index = max(0, len(session_dicts) - 1)

            stdscr.erase()
            height, width = stdscr.getmaxyx()
            header = f"agent-workflow dashboard | {len(session_dicts)} visible | filter={query or '-'}"
            stdscr.addnstr(0, 0, header, width - 1, curses.A_BOLD)
            stdscr.addnstr(1, 0, "Enter focus  r refresh  / filter  q quit", width - 1)

            flat_rows: list[tuple[str | None, dict[str, Any] | None]] = []
            for section_name, rows in dashboard_sections(session_dicts):
                flat_rows.append((section_name, None))
                for row in rows:
                    flat_rows.append((None, row))

            line = 3
            visible_rows = 0
            for _, row in flat_rows:
                if row:
                    visible_rows += 1
            display_index = 0
            for section_name, row in flat_rows:
                if line >= height - 2:
                    break
                if section_name:
                    stdscr.addnstr(line, 0, section_name, width - 1, curses.A_UNDERLINE | curses.A_BOLD)
                    line += 1
                    continue
                assert row is not None
                attrs = curses.A_REVERSE if display_index == selected_index else curses.A_NORMAL
                stdscr.addnstr(line, 0, format_row(row, width - 1), width - 1, attrs)
                display_index += 1
                line += 1

            generated_at = snapshot.get("generated_at", "")
            footer = f"updated {age_text(generated_at)} ago"
            stdscr.addnstr(height - 1, 0, footer, width - 1, curses.A_DIM)
            stdscr.refresh()

            key = stdscr.getch()
            if key == -1:
                time.sleep(0.05)
                continue
            if key in (ord("q"), 27):
                return 0
            if key in (ord("r"),):
                snapshot = build_snapshot()
                last_refresh = time.monotonic()
                continue
            if key in (curses.KEY_DOWN, ord("j")) and selected_index < max(0, visible_rows - 1):
                selected_index += 1
                continue
            if key in (curses.KEY_UP, ord("k")) and selected_index > 0:
                selected_index -= 1
                continue
            if key == ord("/"):
                curses.curs_set(1)
                curses.echo()
                stdscr.move(height - 1, 0)
                stdscr.clrtoeol()
                stdscr.addstr(height - 1, 0, "filter: ")
                value = stdscr.getstr(height - 1, 8).decode("utf-8", "replace")
                query = value.strip()
                curses.noecho()
                curses.curs_set(0)
                selected_index = 0
                continue
            if key in (10, 13, curses.KEY_ENTER) and session_dicts:
                focus_session(session_dicts[selected_index]["session_key"], snapshot)
        return 0

    return curses.wrapper(main)


def focus_session(session_key: str, snapshot: dict[str, Any] | None = None) -> int:
    if snapshot is None:
        if SCAN_CACHE_PATH.exists():
            data = load_json(SCAN_CACHE_PATH)
            snapshot = data if isinstance(data, dict) else build_snapshot()
        else:
            snapshot = build_snapshot()
    session = find_session(snapshot, session_key)
    if not session:
        print(f"unknown session_key: {session_key}", file=sys.stderr)
        return 1
    kitty_ok = focus_kitty(session.get("kitty_target"))
    nvim_ok = focus_nvim(session.get("nvim_target"), session_key)
    if not kitty_ok and not nvim_ok:
        print("unable to focus kitty or Neovim target", file=sys.stderr)
        return 1
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="agent-workflow")
    subparsers = parser.add_subparsers(dest="command", required=True)

    dashboard = subparsers.add_parser("dashboard")
    dashboard.set_defaults(func=lambda _args: run_dashboard())

    scan = subparsers.add_parser("scan")
    scan.add_argument("--json", action="store_true", help="emit JSON snapshot")
    scan.set_defaults(func=cmd_scan)

    summary = subparsers.add_parser("summary")
    summary.set_defaults(func=cmd_summary)

    focus = subparsers.add_parser("focus")
    focus.add_argument("session_key")
    focus.set_defaults(func=lambda args: focus_session(args.session_key))

    return parser


def cmd_scan(args: argparse.Namespace) -> int:
    snapshot = build_snapshot()
    if args.json:
        json.dump(snapshot, sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
        return 0
    for session in snapshot.get("sessions", []):
        print(f"{session['session_key']}\t{session['state']}\t{session['cwd']}")
    return 0


def cmd_summary(_args: argparse.Namespace) -> int:
    snapshot = build_snapshot()
    print_summary(snapshot)
    return 0


def main() -> int:
    ensure_state_dirs()
    parser = build_parser()
    args = parser.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
