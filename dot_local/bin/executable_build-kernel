#!/usr/bin/env bash
set -euo pipefail

if (( EUID != 0 )); then
  if ! command -v sudo >/dev/null 2>&1; then
    echo "sudo is required to elevate privileges for build-kernel" >&2
    exit 1
  fi

  script_path=$(readlink -f "${BASH_SOURCE[0]}")
  if [[ -z "$script_path" || ! -x "$script_path" ]]; then
    echo "unable to resolve executable script path for build-kernel" >&2
    exit 1
  fi

  exec sudo --preserve-env=KERNEL_DIR,INSTALLKERNEL_LOG,BUILD_JOBS "$script_path" "$@"
fi

kernel_dir=${KERNEL_DIR:-/usr/src/linux}
installkernel_log=${INSTALLKERNEL_LOG:-/var/log/installkernel.log}

if [[ "$kernel_dir" != /* ]]; then
  echo "KERNEL_DIR must be an absolute path (got: $kernel_dir)" >&2
  exit 1
fi

case "$kernel_dir" in
  /usr/src/*) ;;
  *)
    echo "KERNEL_DIR must be under /usr/src for safety (got: $kernel_dir)" >&2
    exit 1
    ;;
esac

if [[ ! -d "$kernel_dir" ]]; then
  echo "kernel source directory not found: $kernel_dir" >&2
  exit 1
fi

cd "$kernel_dir"

step() {
  printf '\n==> %s\n' "$1"
}

step "Importing running kernel config into .config"

if [[ ! -r /proc/config.gz ]]; then
  echo "running kernel config not readable: /proc/config.gz" >&2
  exit 1
fi

if ! command -v zcat >/dev/null 2>&1; then
  echo "zcat is required to import running kernel config" >&2
  exit 1
fi

zcat /proc/config.gz > .config

if ! command -v emerge >/dev/null 2>&1; then
  echo "emerge is required for @module-rebuild" >&2
  exit 1
fi

kernel_release=$(make -s kernelrelease)
jobs=${BUILD_JOBS:-$(nproc)}

step "Target kernel release: ${kernel_release}"
step "Reviewing new kernel config options with make oldconfig"
make oldconfig

step "Building kernel with ${jobs} job(s)"
make -j"${jobs}"

step "Installing kernel modules"
make modules_install

step "Rebuilding external modules via @module-rebuild"
emerge -q @module-rebuild

step "Installing kernel via make install"
cat <<MSG
This system is expected to delegate kernel installation to installkernel.
On this host, that means dracut-generated UKIs are written to the EFI system partition.
MSG
make install

if [[ -r "$installkernel_log" ]]; then
  step "Latest installkernel log entry"
  tail -n 1 "$installkernel_log"
else
  step "installkernel log not readable at ${installkernel_log}"
fi

step "Post-install checks"
printf 'Expected EFI output path: %s\n' '/efi/EFI/Linux/gentoo-<version>.efi'
printf 'Run after reboot to confirm the new kernel: %s\n' 'uname -r'
