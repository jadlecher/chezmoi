# Generated by kitty when switching themes
/.config/kitty/current-theme.conf
/.config/kitty/current-background.conf

# Generated by lazy.nvim plugin updates
/.config/nvim/lazy-lock.json

# Generated by local hypr theme script
/.config/hypr/conf-enabled/**

# Local shell secrets (kept out of chezmoi source; sourced by ~/.bashrc)
/.config/shell/secrets.local

# Repo-internal agent instructions; do not deploy to $HOME
/AGENTS.md

# Repo documentation; do not deploy to $HOME
/README.md

# Local image catalog overrides are machine-specific and untracked
/.config/media/image-catalog.local.yaml

{{- $osrel := lower .chezmoi.kernel.osrelease -}}
{{- if or (contains $osrel "microsoft") (contains $osrel "wsl") }}
# Hyprland and Waybar do not apply on WSL
/.config/hypr/**
/.config/waybar/**
{{- end }}
