# Local shell secrets (not tracked by git/chezmoi).
# Copy to ~/.config/shell/secrets.local and chmod 600.
# Fetch the AI CLI OTel ingest token with:
# export AI_CLI_OTEL_INGEST_TOKEN="$(kubectl get secret otel-gateway-ingest -n monitoring -o jsonpath='{.data.token}' | base64 -d)"
# Set the private domains used by OTel and qutebrowser SSO:
# export OTEL_DOMAIN="..."
# export SSO_DOMAIN="..."

# export GEMINI_API_KEY="..."
# export ANTHROPIC_API_KEY="..."
# export OPENAI_API_KEY="..."
# export AI_CLI_OTEL_INGEST_TOKEN="..."
