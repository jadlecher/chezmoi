# Local shell secrets (not tracked by git/chezmoi).
# Copy to ~/.config/shell/secrets.local and chmod 600.
# Configure private OTel and qutebrowser SSO values:
# export AI_CLI_OTEL_ENDPOINT="https://..."
# export AI_CLI_OTEL_ENVIRONMENT="..."
# export QUTEBROWSER_SSO_HOST="..."

# export GEMINI_API_KEY="..."
# export ANTHROPIC_API_KEY="..."
# export OPENAI_API_KEY="..."
# export AI_CLI_OTEL_INGEST_TOKEN="..."
